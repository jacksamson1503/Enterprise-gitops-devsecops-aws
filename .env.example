# Server Port
PORT=3000
NODE_ENV=production

# AWS Region & Credentials (On EC2, IAM Role handles this automatically without keys!)
AWS_REGION=us-east-1

# DynamoDB Configuration
DYNAMODB_USERS_TABLE=KilnClay_Users
JWT_SECRET=super-secret-jwt-key-change-this-in-prod

# Amazon RDS PostgreSQL Configuration
RDS_HOST=your-rds-endpoint.c7xxxxxx.us-east-1.rds.amazonaws.com
RDS_PORT=5432
RDS_DATABASE=kilnclay_orders
RDS_USER=postgres
RDS_PASSWORD=YourSecureRdsPassword123!

# Amazon SNS Configuration (Order Confirmation Notification)
SNS_ORDER_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:OrderConfirmationTopic
